# Required in production (32 random bytes, base64url). Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DOCMIND_ENV=development
DOCMIND_MASTER_KEY=
DOCMIND_JWT_SECRET=
DOCMIND_DATA_DIR=./data
DOCMIND_SECURE_COOKIES=0

# Optional: Gmail / Google Drive (see docs/INTEGRATIONS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback

# Optional: external LLM for request understanding (anthropic | openai | none). Never receives documents.
DOCMIND_LLM_PROVIDER=none
DOCMIND_LLM_API_KEY=
DOCMIND_LLM_MODEL=

# Shared aggregate learning — keep off until privacy review is complete.
DOCMIND_SHARED_LEARNING=0
